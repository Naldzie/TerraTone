# Copy to .env for local development. No secrets required for core experience.
VITE_APP_NAME=TerraTone
# Optional: personal keys (prefer entering them in Settings → API keys instead,
# which keeps them in browser localStorage only). NEVER commit real keys.
# VITE_NASA_API_KEY=
# VITE_GEMINI_API_KEY=
# Optional: default map tile service base (GIBS WMTS, keyless).
VITE_GIBS_BASE=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best
VITE_POWER_BASE=https://power.larc.nasa.gov/api
# Optional: GitHub repository used for installer releases ("owner/repo").
# When set, download buttons use the stable release asset names produced by
# .github/workflows/release.yml (TerraTone-Windows-Setup.exe, TerraTone-macOS.dmg,
# TerraTone-Android.apk). Leave unset to use the browser PWA install flow.
# VITE_GITHUB_REPO=owner/terratone
# Optional: direct installer URLs (override the GitHub release assets).
# For local testing, stage files into frontend/downloads/ and use .env.local:
# VITE_INSTALLER_WINDOWS=/downloads/TerraTone-Windows-Setup.exe
# VITE_INSTALLER_MAC=/downloads/TerraTone-macOS.dmg
# VITE_INSTALLER_PHONE=/downloads/TerraTone-Android.apk
# Optional: signed iOS IPA or TestFlight URL. The release workflow does not build iOS.
# VITE_INSTALLER_IOS=https://example.com/TerraTone.ipa
