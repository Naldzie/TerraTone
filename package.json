{
  "name": "terratone",
  "version": "2.0.0",
  "private": true,
  "description": "TerraTone — Hear the Pulse of Our Planet. Earth science sonification PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "vite preview --port 4173",
    "desktop:dev": "npm --prefix electron start",
    "desktop:build": "npm --prefix electron run build",
    "desktop:build:win": "npm --prefix electron run build:win",
    "desktop:build:mac": "npm --prefix electron run build:mac",
    "android:sync": "npm run build && cap sync android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:stage": "node scripts/stage-installers.mjs",
    "ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
